# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Used by utils/radio_analysis.py (Strands Agent + Google Gemini) to classify team-radio
# transcripts as driver/pit-wall and surface notable messages (box calls, incidents, etc.).
GEMINI_API_KEY=your-gemini-api-key-here

# Optional - defaults to gemini-3.5-flash-lite if unset.
GEMINI_MODEL_ID=gemini-3.5-flash-lite
