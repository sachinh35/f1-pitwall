# Copy this file to .env (gitignored) at the repo root. docker-compose.yml
# reads it automatically for the db/migrate/backend services.

# Postgres - defaults below match docker-compose.yml's own defaults, so this
# whole block is optional unless you want to change them.
DB_USER=postgres
DB_NAME=f1-analytics

# Uncomment to point migrate/backend at a Postgres you already have running
# instead of the db service docker-compose.yml also starts (that service
# still starts either way; it just goes unused). host.docker.internal reaches
# a Postgres running natively on your Mac/Windows host - works out of the box
# on Docker Desktop; on Linux add `extra_hosts:
# ["host.docker.internal:host-gateway"]` to the migrate/backend services in
# docker-compose.yml first. Your local Postgres also needs to actually accept
# TCP connections from it (check listen_addresses and pg_hba.conf) - a
# default install that only accepts local Unix-socket connections will
# refuse it.
# DB_HOST=host.docker.internal
# DB_PORT=5432
# DB_USER=your-local-username
# DB_PASSWORD=

# Optional - only needed for the team-radio "notable message" classifier
# (backend/utils/radio_analysis.py). Everything else runs fine without it.
GEMINI_API_KEY=
GEMINI_MODEL_ID=
